<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DETALLE DEL CURSO"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <ImageView
            android:id="@+id/imgCurso"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:background="#F0F0F0"
            android:scaleType="centerCrop"
            android:contentDescription="Imagen del curso" />

        <TextView
            android:id="@+id/txtNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Nombre del curso"
            android:textColor="#000000"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtCodigo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Código:"
            android:textColor="#000000"
            android:textSize="17sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="22dp"
            android:background="#DDDDDD" />

        <TextView
            android:id="@+id/txtDescripcion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Descripción:"
            android:textColor="#000000"
            android:textSize="17sp"
            android:lineSpacingExtra="5dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="22dp"
            android:background="#DDDDDD" />

        <TextView
            android:id="@+id/txtEspacio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Espacio:"
            android:textColor="#000000"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/txtHoras"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Total de horas:"
            android:textColor="#000000"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/txtDias"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Días de atención:"
            android:textColor="#000000"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/txtHorario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Horario:"
            android:textColor="#000000"
            android:textSize="17sp" />

        <Button
            android:id="@+id/btnRegresar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="36dp"
            android:layout_marginBottom="20dp"
            android:backgroundTint="#D8BFFF"
            android:text="REGRESAR AL CATÁLOGO"
            android:textColor="#000000"
            android:textStyle="bold"
            android:textSize="15sp" />

    </LinearLayout>

</ScrollView>
